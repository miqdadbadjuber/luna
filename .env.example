# Clip ranking: any OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional alternative: Gemini. Set LLM_PROVIDER=gemini or leave OPENAI_API_KEY blank.
# For transcription, set LOCAL_TRANSCRIBE_PROVIDER=gemini.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Transcription when a video has no subtitles: groq, gemini, or whisper to run it locally
LOCAL_TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Pipeline Settings
LOCAL_OUTPUT_DIR=output
MEDIA_STORAGE_DIR=
